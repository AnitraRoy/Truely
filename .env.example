# Copy to .env.local or .env (both gitignored; .env.local wins). Read by the
# desktop shell and the Vite dev server (npm run dev) only, never bundled into
# the web app. Do not commit real keys.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
CARTESIA_API_KEY=
APIFY_TOKEN=
